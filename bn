#!/data/data/com.termux/files/usr/bin/sh
# bn: the spec-era successor of the nn launcher - given a
# round number, open the round's spec JSON in nano with the
# correct name, so a paste never lands in a mistyped path.
#   Usage:  ./bn 430   -> nano tools/spec_r430.json
# (user-side convenience only; it stays OUT of the ritual
# block and out of the repo, per the R369/R372 standing
# decision.)
set -eu
R="$1"
case "$R" in
  ''|*[!0-9]*)
    echo 'usage: bn <round-number>' >&2
    exit 1
    ;;
esac
mkdir -p tools
exec nano "tools/spec_r${R}.json"

