// ============================================================================
// Adnd1 — rules/rules_test.cpp
// Minimal self-contained test harness. Every rules/ domain adds CHECKs here.
//
// Build & run (MinGW or Linux):
//   g++ -std=c++17 -I. rules/dice.cpp rules/character.cpp rules/rules_test.cpp -o rules_test
//   ./rules_test
//
// Exit code 0 = all checks passed. No external test framework: the harness is
// a single CHECK macro plus a pass/fail summary, so it builds anywhere the
// game builds.
// ============================================================================

#include "dice.h"
#include "character.h"

#include <cstdio>
#include <cstring>

static int g_checks = 0;
static int g_failures = 0;

#define CHECK(cond) do {                                              \
    ++g_checks;                                                       \
    if (!(cond)) {                                                    \
        ++g_failures;                                                 \
        std::printf("FAIL %s:%d  %s\n", __FILE__, __LINE__, #cond);   \
    }                                                                 \
} while (0)

int main() {
    using namespace rules;

    // ---- determinism: same seed, same sequence -----------------------------
    {
        Rng a(42), b(42);
        Dice da(a), db(b);
        bool same = true;
        for (int i = 0; i < 1000; ++i)
            if (da.d20() != db.d20()) { same = false; break; }
        CHECK(same);
    }
    // different seeds diverge (practically certain within 1000 rolls)
    {
        Rng a(42), b(43);
        Dice da(a), db(b);
        bool diverged = false;
        for (int i = 0; i < 1000; ++i)
            if (da.d20() != db.d20()) { diverged = true; break; }
        CHECK(diverged);
    }

    // ---- ranges -------------------------------------------------------------
    {
        Rng r(7); Dice d(r);
        bool ok = true;
        for (int i = 0; i < 10000; ++i) {
            uint32_t v = d.d20();
            if (v < 1 || v > 20) { ok = false; break; }
        }
        CHECK(ok);
    }
    {
        Rng r(7); Dice d(r);
        bool ok = true;
        for (int i = 0; i < 10000; ++i) {
            uint32_t v = d.d100();
            if (v < 1 || v > 100) { ok = false; break; }
        }
        CHECK(ok);
    }

    // ---- roll(count, sides, bonus) -----------------------------------------
    {
        Rng r(9); Dice d(r);
        int32_t v = d.roll(3, 6, 0);           // 3d6
        CHECK(v >= 3 && v <= 18);
        v = d.roll(2, 8, 1);                   // 2d8+1
        CHECK(v >= 3 && v <= 17);
        v = d.roll(0, 6, 5);                   // flat bonus only
        CHECK(v == 5);
        v = d.roll(1, 1, 0);                   // fixed die
        CHECK(v == 1);
    }

    // ---- bestOf: 4d6 drop lowest -------------------------------------------
    {
        Rng r(11); Dice d(r);
        bool ok = true;
        for (int i = 0; i < 10000; ++i) {
            int32_t v = d.bestOf(4, 6, 3);
            if (v < 3 || v > 18) { ok = false; break; }
        }
        CHECK(ok);
    }
    // bestOf with keep >= count equals a plain roll's bounds
    {
        Rng r(13); Dice d(r);
        int32_t v = d.bestOf(3, 6, 5);         // degenerates to 3d6
        CHECK(v >= 3 && v <= 18);
        CHECK(d.bestOf(4, 6, 0) == 0);
        CHECK(d.bestOf(0, 6, 3) == 0);
    }

    // ---- range()/below() edge cases ----------------------------------------
    {
        Rng r(1);
        CHECK(r.below(1) == 0);
        CHECK(r.range(5, 5) == 5);
        CHECK(r.range(2, 3) == 2 || r.range(2, 3) == 3);
        uint32_t v = r.range(1, 100);
        CHECK(v >= 1 && v <= 100);
    }

    // ---- uniformity smoke test: d20 faces all appear -----------------------
    {
        Rng r(2024); Dice d(r);
        bool seen[21] = {};
        for (int i = 0; i < 20000; ++i) seen[d.d20()] = true;
        bool all = true;
        for (int f = 1; f <= 20; ++f) if (!seen[f]) { all = false; break; }
        CHECK(all);
    }

    // ========================================================================
    // R3: rules/character — PHB p.9-13 ability tables
    // ========================================================================

    // ---- exceptional strength bands (PHB p.9) -------------------------------
    {
        auto mk = [](int pct) {
            ExceptionalStrength e; e.has = true; e.pct = (uint8_t)pct; return e;
        };
        ExceptionalStrength none{};

        CHECK(none.hitAdj() == 0 && none.dmgAdj() == 0);

        CHECK(mk(1).hitAdj()  == 1 && mk(50).hitAdj()  == 1);
        CHECK(mk(51).hitAdj() == 2 && mk(75).hitAdj()  == 2);
        CHECK(mk(76).hitAdj() == 2 && mk(90).hitAdj()  == 2);
        CHECK(mk(91).hitAdj() == 3 && mk(99).hitAdj()  == 3);
        CHECK(mk(100).hitAdj()== 3);

        CHECK(mk(1).dmgAdj()  == 3 && mk(50).dmgAdj()  == 3);
        CHECK(mk(51).dmgAdj() == 4);
        CHECK(mk(76).dmgAdj() == 5);
        CHECK(mk(91).dmgAdj() == 6 && mk(100).dmgAdj() == 6);
    }

    // ---- STR to-hit / damage (PHB p.9) --------------------------------------
    {
        ExceptionalStrength none{};
        ExceptionalStrength ex{}; ex.has = true; ex.pct = 100;

        CHECK(strHitAdj(3, none)  == -3);
        CHECK(strHitAdj(5, none)  == -2);
        CHECK(strHitAdj(7, none)  == -1);
        CHECK(strHitAdj(13, none) == 0);
        CHECK(strHitAdj(17, none) == 1);
        CHECK(strHitAdj(18, none) == 1);
        CHECK(strHitAdj(18, ex)   == 3);    // exceptional replaces, not adds
        CHECK(strHitAdj(16, none) == 0);

        CHECK(strDmgAdj(3, none)  == -1);
        CHECK(strDmgAdj(13, none) == 0);
        CHECK(strDmgAdj(16, none) == 1);
        CHECK(strDmgAdj(18, none) == 2);
        CHECK(strDmgAdj(18, ex)   == 6);
    }

    // ---- DEX (PHB p.11-12) ---------------------------------------------------
    {
        CHECK(dexReactionAdj(3)  == -2);
        CHECK(dexReactionAdj(5)  == -1);
        CHECK(dexReactionAdj(9)  == 0);
        CHECK(dexReactionAdj(16) == 1);
        CHECK(dexReactionAdj(18) == 2);

        CHECK(dexDefensiveAdj(3)  == 4);
        CHECK(dexDefensiveAdj(6)  == 1);
        CHECK(dexDefensiveAdj(10) == 0);
        CHECK(dexDefensiveAdj(15) == -1);
        CHECK(dexDefensiveAdj(18) == -4);
    }

    // ---- CON (PHB p.12) ------------------------------------------------------
    {
        CHECK(conHPAdj(3)  == -2);
        CHECK(conHPAdj(5)  == -1);
        CHECK(conHPAdj(10) == 0);
        CHECK(conHPAdj(15) == 1);
        CHECK(conHPAdj(18) == 2);

        CHECK(conSystemShock(3)  == 25);
        CHECK(conSystemShock(18) == 96);
        CHECK(conResSurvival(3)  == 30);
        CHECK(conResSurvival(18) == 98);

        CHECK(conPoisonSaveAdj(3)  == -2);
        CHECK(conPoisonSaveAdj(12) == 0);
        CHECK(conPoisonSaveAdj(18) == 2);
    }

    // ---- INT / WIS / CHA (PHB p.10-11) --------------------------------------
    {
        CHECK(intExtraLanguages(3)  == 0);
        CHECK(intExtraLanguages(4)  == 1);
        CHECK(intExtraLanguages(10) == 3);
        CHECK(intExtraLanguages(18) == 6);

        CHECK(wisMagDefAdj(3)  == -2);
        CHECK(wisMagDefAdj(7)  == -1);
        CHECK(wisMagDefAdj(10) == 0);
        CHECK(wisMagDefAdj(15) == 1);
        CHECK(wisMagDefAdj(18) == 2);

        CHECK(chaReactionAdj(3)  == -4);
        CHECK(chaReactionAdj(9)  == 0);
        CHECK(chaReactionAdj(16) == 2);
        CHECK(chaReactionAdj(18) == 4);

        CHECK(chaHenchmenMax(3)  == 1);
        CHECK(chaHenchmenMax(9)  == 4);
        CHECK(chaHenchmenMax(18) == 15);

        CHECK(chaLoyaltyBase(3)  == 1);
        CHECK(chaLoyaltyBase(12) == 7);
        CHECK(chaLoyaltyBase(18) == 15);
    }

    // ---- prime requisite XP pct (PHB p.12-13) -------------------------------
    {
        CHECK(primeRequisitePct(3)  == XP_MINUS20);
        CHECK(primeRequisitePct(6)  == XP_MINUS10);
        CHECK(primeRequisitePct(9)  == XP_NONE);
        CHECK(primeRequisitePct(13) == XP_PLUS5);
        CHECK(primeRequisitePct(16) == XP_PLUS10);
        CHECK(primeRequisitePct(18) == XP_PLUS10);
    }

    // ---- ability generation bounds + determinism ----------------------------
    {
        Rng r(77); Dice d(r);
        bool ok = true;
        for (int i = 0; i < 2000; ++i) {
            AbilityScores s = rollAbilities(d, GEN_3D6);
            for (int a = 0; a < ABILITY_COUNT; ++a)
                if (s.get((Ability)a) < 3 || s.get((Ability)a) > 18) ok = false;
        }
        CHECK(ok);

        Rng r2(78); Dice d2(r2);
        ok = true;
        for (int i = 0; i < 2000; ++i) {
            AbilityScores s = rollAbilities(d2, GEN_4D6_DROP);
            for (int a = 0; a < ABILITY_COUNT; ++a)
                if (s.get((Ability)a) < 3 || s.get((Ability)a) > 18) ok = false;
        }
        CHECK(ok);

        // same seed -> identical character
        Rng ra(5), rb(5); Dice da(ra), db(rb);
        AbilityScores sa = rollAbilities(da, GEN_4D6_DROP);
        AbilityScores sb = rollAbilities(db, GEN_4D6_DROP);
        CHECK(sa.str == sb.str && sa.int_ == sb.int_ && sa.wis == sb.wis &&
              sa.dex == sb.dex && sa.con == sb.con && sa.cha == sb.cha);
    }

    std::printf("%d checks, %d failures\n", g_checks, g_failures);
    return g_failures == 0 ? 0 : 1;
}